  "snippets": [
    {
      "id": "s-open",
      "evidenceId": "ev-open",
      "label": "打开入口的核心代码",
      "language": "c",
      "segments": [
        {
          "kind": "source",
          "startLine": 58,
          "endLine": 62,
          "text": "int minifs_open(const char *path, struct File **out)\n{\n    if (out == NULL)\n        return -22;\n    *out = NULL;"
        },
        {
          "kind": "omission",
          "startLine": 63,
          "endLine": 63,
          "reason": "省略教学用、无副作用的审计占位调用；其定义已读取。"
        },
        {
          "kind": "source",
          "startLine": 64,
          "endLine": 79,
          "text": "    struct Inode *inode = lookup_inode(path);\n    if (inode == NULL)\n        return -2;\n    if (!inode->readable)\n        return -13;\n    struct File *file = allocate_file(inode);\n    if (file == NULL)\n        return -12;\n    int rc = file->ops->open(file);\n    if (rc < 0) {\n        release_file(file);\n        return rc;\n    }\n    *out = file;\n    return 0;\n}"
        }
      ],
